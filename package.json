{
    "name": "n8n-nodes-tanss",
    "version": "1.1.22",
    "description": "n8n community node to use the TANSS API",
    "license": "MIT",
    "homepage": "https://github.com/BuddiesD/n8n-nodes-tanss",
    "keywords": [
        "n8n-community-node-package",
        "n8n-nodes-tanss",
        "Tanss"
    ],
    "author": {
        "name": "J.W",
        "email": "dev@buddies-dev.de"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BuddiesD/n8n-nodes-tanss.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "check:display-names": "node ./scripts/check-display-names.mjs",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/TanssUserApi.credentials.js",
            "dist/credentials/TanssGeneratedTokenApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/tanss/Tanss.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.34.0",
        "@types/node": "^25.9.2",
        "eslint": "9.32.0",
        "n8n-workflow": "^2.16.0",
        "prettier": "3.6.2",
        "release-it": "^20.2.0",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
